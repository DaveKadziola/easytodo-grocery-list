# EasyToDo configuration. Copy to .env (git-ignored) and edit:
#   cp .env.example .env
# docker compose reads this file for its own variables (POSTGRES_PASSWORD, EASYTODO_PORT, ...) and
# passes it to the app container, where the EASYTODO_* variables configure the app.
# docker compose fills in ${...} in the values here: wrap a value that contains a "$" (an SMTP
# password, say) in single quotes, e.g. EASYTODO_SMTP_PASSWORD='pa$$word', or it is changed.
# Ways to deploy (home network, own domain with HTTPS, tunnel): docs/deployment.md.

# ---- PostgreSQL (the `db` service of docker-compose.yml) ----
# Change this before the first `docker compose up`: Postgres stores the password in the pgdata
# volume on first start, so changing it later does not change the database's password.
# Use only letters and digits (e.g. `openssl rand -hex 24`): it is embedded in the URL below.
POSTGRES_PASSWORD=change-me

# ---- Required ----
# SQLAlchemy URL of the database. The default matches the `db` service; ${POSTGRES_PASSWORD}
# is filled in by docker compose.
EASYTODO_DATABASE_URL=postgresql+asyncpg://easytodo:${POSTGRES_PASSWORD}@db:5432/easytodo
# Encrypts the secrets the app stores in the database. At least 32 characters; the app refuses
# to start with a shorter one. Generate one: openssl rand -hex 32
# Keep it stable: after changing it, secrets stored earlier can no longer be decrypted.
EASYTODO_SECRET_KEY=

# ---- Web ----
# Address people type in the browser, without a trailing path; links in mails and invites use
# it. Its origin, and those in EASYTODO_EXTRA_ORIGINS below, are the only ones the app accepts
# on form submissions (CSRF check) and live updates: to use the app from a phone on the home
# network, set it to the server's LAN address, e.g. http://192.168.1.20:8000. An https:// URL
# also marks the session cookie Secure.
EASYTODO_PUBLIC_URL=http://localhost:8000
# More addresses the app is opened at, comma-separated (scheme://host:port), e.g. to keep
# http://localhost:8000 working next to the LAN address above. Links still use
# EASYTODO_PUBLIC_URL. With an https:// EASYTODO_PUBLIC_URL these must be https:// too (the app
# refuses to start otherwise): the session cookie is Secure, so the browser never sends it to
# an http address and signing in there would loop. Unset or empty: none.
# EASYTODO_EXTRA_ORIGINS=http://192.168.122.50:8000, http://localhost:8000
# Host port published by docker compose (the container always listens on 8000). When you
# change it, use the same port in EASYTODO_PUBLIC_URL above.
# EASYTODO_PORT=8000
# Host address that port is published on. Unset: every interface, so the home network reaches
# the app. Set 127.0.0.1 with the `proxy` profile (below): Caddy is then the only way in.
# On a server with a public IP address, set 127.0.0.1 (and use docs/deployment.md (b) or (c)):
# unset, the app is on the internet over plain HTTP, open to registration, and Docker's
# published ports bypass firewalls such as ufw.
# EASYTODO_BIND=127.0.0.1
# Uvicorn worker processes. One is plenty for a household. The rate limits (and the 2FA code
# budget per account) are kept in each worker's memory, so N workers allow N times as many
# attempts, and a restart starts them afresh; keep 1 on an install reachable from the internet.
# EASYTODO_WORKERS=1
# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted. Name ONLY your reverse
# proxy: with a too-broad value anyone can spoof their IP and dodge the per-IP rate limits.
# Leave the default when the app is reached directly, without a proxy in front of it.
# With the `proxy` profile set it to * (Caddy's address changes), and ONLY together with
# EASYTODO_BIND=127.0.0.1, so that nobody but Caddy and this machine can send these headers.
EASYTODO_FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Behaviour ----
# dev | test | prod: a label only, nothing in the app reads it.
EASYTODO_ENV=prod
# true: anyone who can reach the app may register. false: the registration page is closed,
# except from a valid invite link: an e-mail invite only for its own address, a link invite for
# anyone who has the link until it expires (7 days) or is revoked (revoke the ones you no
# longer need on the board's Members page).
EASYTODO_REGISTRATION_OPEN=true
# How long a login stays valid, in days.
EASYTODO_SESSION_TTL_DAYS=30
# Files attached to items (images, PDF, .txt, .md). Where they are kept: in the image
# /app/backend/data/attachments, on the volume "attachments" (docker-compose.yml); change it only
# when running without Docker.
# EASYTODO_ATTACHMENTS_DIR=data/attachments
# The largest file, in bytes (10 MiB).
# EASYTODO_ATTACHMENT_MAX_BYTES=10485760
# How many files one task can have.
# EASYTODO_ATTACHMENTS_PER_ITEM=20
# All files of the instance together, in bytes (2 GiB); beyond it no file is accepted.
# EASYTODO_ATTACHMENTS_TOTAL_BYTES=2147483648

# ---- Mail (password resets, e-mail invitations) ----
# console: mails are only written to the app log (reset and invite links included, so not for
# production). smtp: sent through the server below.
EASYTODO_MAIL_BACKEND=console
# EASYTODO_SMTP_HOST=smtp.example.com
# EASYTODO_SMTP_PORT=587
# EASYTODO_SMTP_USER=
# EASYTODO_SMTP_PASSWORD=
# EASYTODO_SMTP_FROM=EasyToDo <noreply@example.com>
# true: upgrade the connection with STARTTLS (port 587). false: never upgrade.
# EASYTODO_SMTP_STARTTLS=true
# Proton Mail: the password is an SMTP token, not the account password (Proton: Settings ->
# IMAP/SMTP -> SMTP tokens; needs a paid plan with a custom domain), and the From address must
# be the token's address. Wrap a token that contains a "$" in single quotes (see the top).
# EASYTODO_MAIL_BACKEND=smtp
# EASYTODO_SMTP_HOST=smtp.protonmail.ch
# EASYTODO_SMTP_PORT=587
# EASYTODO_SMTP_STARTTLS=true
# EASYTODO_SMTP_USER=todo@your-domain.example
# EASYTODO_SMTP_PASSWORD=<the SMTP token>
# EASYTODO_SMTP_FROM=EasyToDo <todo@your-domain.example>

# ---- HTTPS reverse proxy (optional: docker compose --profile proxy up -d) ----
# Caddy gets a certificate for EASYTODO_DOMAIN and forwards to the app. Both values are
# required with the profile. Also set EASYTODO_PUBLIC_URL=https://<EASYTODO_DOMAIN>,
# EASYTODO_BIND=127.0.0.1 and EASYTODO_FORWARDED_ALLOW_IPS=* (see above).
# Domain name whose DNS record points at this server (ports 80 and 443 forwarded to it).
# EASYTODO_DOMAIN=todo.example.com
# Contact e-mail for the certificate authority account (Let's Encrypt expiry notices).
# ACME_EMAIL=you@example.com
